# Art pack — NOT tracked. ~3.8 GB / 14k files of 5etools art made .git 5.6 GB
# and pushed the site past GitHub Pages' 1 GB limit, so the images are served
# from object storage instead (see js/asset-config.js and SETUP.md).
# The local copy stays on disk as the master source for uploads + thumbnails.
/img/

# Generated browse-sized thumbnails (tools/make-thumbs.py). Derived from
# /img/, uploaded alongside it — no reason to version them.
/thumbs/

# Local scratch
*.log
upload.log

# scratch output from data-audit scripts
*.tmp

# Vendored 5etools v2.28.0 reference copy — 1,572 files the app never loads.
# Kept beside the repo (../DND_Site-reference/) so project-wide greps and
# editor file-search stop drowning in it. Nothing in js/, styles/, tools/,
# skt-workspace.html, sw.js or manifest.json references it.
/5etools-v2.28.0/

# Screenshots from tools/shot.js — local artifacts, not source.
tools/shots/

# Live campaign snapshots pulled by tools/pull-state.js, plus the cached
# anonymous session it reuses. Real campaign data and a refresh token — the
# repo is public, so neither belongs in it.
/.state/
